# Public DNS name. Its A/AAAA record must point to this host for Let's Encrypt HTTP-01.
SMTP_HOSTNAME=relay.example.com
MAIL_DOMAIN=example.com
LETSENCRYPT_EMAIL=admin@example.com

# Microsoft 365 authenticated SMTP submission. Postfix will use STARTTLS.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
UPSTREAM_TLS_SECURITY=verify
# Avoid Docker DNS failures while resolving the upstream AAAA record.
# Set to all only when the Docker host and resolver have working IPv6.
SMTP_INET_PROTOCOLS=ipv4

# Microsoft 365 requires SMTP AUTH for this route.
# Create secrets/sasl_passwd with: [smtp.office365.com]:587 username:password
UPSTREAM_SASL_ENABLE=yes

# Do not include arbitrary Docker subnets here. External clients authenticate through STARTTLS + SMTP AUTH.
TRUSTED_NETWORKS=127.0.0.0/8 [::1]/128

# Bind to a private VPN address instead of 0.0.0.0 if all senders are on a VPN.
SMTP_LISTEN_ADDR=0.0.0.0
HTTP_LISTEN_ADDR=0.0.0.0
